#!/bin/sh
# Crochet pre-commit de DuneI (L1-21) : refuse un commit dont generated/ diffère de ce que produisent les
# sources du même commit. Les sources et generated/ sont lus dans l'index, exporté dans un dossier jetable
# où generated/ est vidé puis régénéré : un commit partiel est jugé sur ce qu'il contient, un fichier
# orphelin apparaît comme supprimé, et l'arbre de travail n'est jamais touché. Seul le shader compilé fait exception :
# il est jugé par l'empreinte de sa source, non par ses octets.
# Entrée : aucune ; git le lance à la racine de l'arbre de travail, GIT_INDEX_FILE parfois relatif.
# Sortie : 0 et rien d'affiché si generated/ indexé égale la génération ; 1 sinon, avec la différence et la
#          consigne sur stderr.
# Erreurs : génération en échec sur les sources indexées (sortie des générateurs, puis refus).
# Dépendances : git, make (cibles tokens, motion, energie, shaders), mktemp, realpath. Activé par make install
# (core.hooksPath = .githooks).
# GIT_INDEX_FILE absolu : relatif, il serait résolu depuis le dossier jetable et lirait un index vide.
GIT_INDEX_FILE=$(realpath "${GIT_INDEX_FILE:-$(git rev-parse --git-path index)}") || exit 1
export GIT_INDEX_FILE
t=$(mktemp -d) || exit 1
trap 'rm -rf "$t"' EXIT
git checkout-index -a --prefix="$t/" && rm -rf "$t/generated" || exit 1
# Le shader compilé et son empreinte sont rendus au dossier jetable : make shaders ne recompile que si la source
# indexée ne répond plus à l'empreinte indexée, car les octets du .qsb dépendent de la version de qsb (D85).
git checkout-index -q --prefix="$t/" -- generated/materiau.frag.qsb generated/materiau.frag.sha256 2>/dev/null
if ! sortie=$(make -s -C "$t" tokens motion energie shaders 2>&1); then
    printf '%s\ncommit refusé : la génération échoue sur les sources indexées (L1-21).\n' "$sortie" >&2
    exit 1
fi
nouveaux=$(git --work-tree="$t" ls-files --others --exclude-standard -- generated/)
git --work-tree="$t" diff --exit-code --stat -- generated/ >&2 && [ -z "$nouveaux" ] && exit 0
[ -z "$nouveaux" ] || printf 'produits par les générateurs, absents de l'"'"'index :\n%s\n' "$nouveaux" >&2
cat >&2 <<'MSG'
commit refusé : generated/ indexé diffère de ce que produisent les sources indexées (L1-21).
generated/ ne s'édite pas à la main : régénérer (make tokens motion energie shaders), git add generated/,
puis recommencer le commit.
MSG
exit 1
