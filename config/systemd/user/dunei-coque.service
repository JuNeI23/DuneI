# Coque de session de DuneI : la barre système (L2-08, L2-09) et, plus tard, la presqu'île, dans un seul Quickshell.
# Posé par DuneI depuis config/ — NE PAS MODIFIER À LA MAIN : make install le remplace.
# Modèle d'unité graphique d'uwsm : liée à graphical-session.target, arrêtée avant le compositeur.
[Unit]
Description=Coque de session DuneI (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target
# Hors session graphique, la coque ne démarre pas (comme l'unité de hypridle).
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=/usr/bin/qs -n -c dunei
# Relancée toujours, même après une sortie propre : la coque qui quitte pendant le verrou revient et le reprend
# derrière son bloc avant que le lanceur ne passe la main à hyprlock (verrouReprise, L2-22).
Restart=always
Slice=app-graphical.slice
# Pages géantes transparentes seulement sur demande explicite (madvise) : en mode « always », khugepaged regonfle en
# pages de 2 Mo les zones que jemalloc a rendues, et la coque garde ce qu'elle a libéré (L2-60, mémoire de la galerie).
MemoryTHP=madvise

[Install]
WantedBy=graphical-session.target
