#!/bin/sh
# dunei-bouton-marche — double appui du bouton marche, lié à XF86PowerOff par donnees/raccourcis.lua (L1-09, D106).
# Un premier appui arme le bouton ; un second, dans les 0,4 s qui suivent, met en veille (D120). Un appui isolé, comme
# l'appui fantôme que le contrôleur embarqué de caladan émet parfois longtemps après un réveil, reste sans effet, de
# même que deux fantômes rapprochés : relevés à 0,5 s au moins, contre 0,33 s au plus pour un double appui volontaire.
# Entrée : aucune ; DUNEI_HORLOGE peut désigner un autre fichier au format de /proc/uptime (tests).
# Sortie : code 0 au premier appui ; au second, celui de systemctl suspend.
# Erreurs : XDG_RUNTIME_DIR absent arrête le script avec le message du shell.
# Dépendances : /proc/uptime (horloge qui ne recule jamais, veille comprise), awk, systemctl, XDG_RUNTIME_DIR.
etat="${XDG_RUNTIME_DIR:?}/dunei-bouton-marche"
fenetre=40   # Écart maximal entre les deux appuis, en centièmes de seconde.
maintenant=$(awk '{ printf "%d", $1 * 100 }' "${DUNEI_HORLOGE:-/proc/uptime}")   # En centièmes de seconde.
avant=$(cat "$etat" 2>/dev/null || echo -1000)
if [ $((maintenant - avant)) -le "$fenetre" ]; then rm -f "$etat"; exec systemctl suspend; fi
echo "$maintenant" > "$etat"
