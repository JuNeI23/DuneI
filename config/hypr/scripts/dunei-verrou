#!/bin/sh
# dunei-verrou — lanceur du verrouillage de DuneI (L2-22, voie B), nommé « verrouilleur » dans energie.toml.
# Rôle : commande la coque, qui fait tomber son bloc et prend le verrou elle-même, surveille le verrou et garde
#        hyprlock en secours, sur la configuration statique ~/.config/hypr/hyprlock.conf. hyprlock part aussitôt si la
#        coque est absente ou muette plus de 0,2 s, si elle disparaît pendant la chute, ou à l'échéance
#        (début + verrouAttente) si la session n'est pas tenue ; une session tenue à l'échéance reste à la coque.
#        Garde : si la coque, verrou tenu, ne répond plus `tient` (disparue, muette, relancée sans bloc), elle a
#        verrouReprise ms pour le reprendre (systemd la relance : Restart=always) ; passé ce délai, le rideau
#        (coque/Rideau, `qs -p`, un calque opaque par écran) est posé, puis hyprlock reprend le verrou derrière lui, et
#        le rideau est retiré à la ligne `onLockLocked` de hyprlock : sans lui, Hyprland montrerait la session 20 à
#        70 ms entre son écran mort et le nouveau verrou. Un hyprlock qui sort en laissant le verrou le rend à la coque
#        si elle répond. Session trouvée tenue à l'appel : gardée par la coque si elle tient ou vit,
#        suivie si un hyprlock la tient, sinon reprise par hyprlock derrière le rideau.
#        Quand la coque tient le verrou pendant que hyprlock le garde (secours, ouverture de session), hyprlock est
#        terminé par SIGTERM, jamais par SIGUSR1, qui rendrait toute la session, verrou de la coque compris. Une seule
#        vérité, `hyprctl -j locked` : ni un nom de processus, ni un code de sortie, ni une durée n'en tiennent lieu,
#        et une réponse manquante ne vaut jamais « rendu ». Toute commande extérieure est bornée dans le temps. Verrou
#        sec, sans chute : `--sec` (ouverture de session : hyprlock d'abord, la coque n'étant pas encore là), veille
#        annoncée par logind ou logind muet. Le lanceur se place dans sa propre unité transitoire
#        (`dunei-verrou.scope`), pour qu'un redémarrage d'hypridle ne tue ni lui ni hyprlock ; un second appel attend
#        le déverrouillage.
# Entrée : `--sec`, facultatif. Délais lus dans ~/.config/dunei/motion.json (`delays.verrouAttente`,
#          `delays.verrouReprise`), valeur par défaut sinon. Couleur du rideau lue dans les jetons installés de la coque
#          (~/.config/dunei/coque-tokens.json et theme.json). Fichiers d'exécution sous $XDG_RUNTIME_DIR/dunei :
#          verrou-sec (demande d'abréger, posée par un second appel avant une veille), verrou-ordre (compteur),
#          verrou-place-<pid> (trace : le lanceur placé a bien démarré), verrou-hyprlock.log (sortie de hyprlock, dont
#          la ligne `onLockLocked`), verrou-rideau.log (sortie du rideau, dont « rideau : posé »). DUNEI_VERROU_PORTEE
#          marque l'appel déjà placé (chemin de sa trace, ou « - » hors unité) ; DUNEI_VERROU_DEBUT porte l'heure de
#          l'appel (ms), d'où part l'échéance ; DUNEI_VERROU_SANS_CHUTE impose le verrou sec au lanceur placé
#          (placement retenté).
# Sortie : 0 si la session a été tenue puis rendue ; 1 si le verrou n'a jamais été tenu après trois lancements de
#          hyprlock, si le compositeur est resté muet trois fois de suite à la sortie de hyprlock, ou s'il est resté
#          muet $SUIVI_MUET ms de suite pendant le suivi d'un verrou ; 2 si l'usage est faux.
# Erreurs : chaque départ de hyprlock en secours, chaque lancement sans verrou tenu, chaque relance, chaque relais vers
#           la coque, chaque reprise par hyprlock après verrouReprise, une échéance dépassée et un échec de
#           systemd-run sont écrits au journal (logger -t dunei-verrou) ; après trois lancements sans verrou, la
#           session reste ouverte, le bloc remonte et une notification critique « Verrouillage impossible »
#           s'affiche, sauf avec `--sec` : dunei-verrou-initial ferme alors la session et le bloc reste posé.
# Dépendances : sh, hyprlock, stdbuf (coreutils : sortie de hyprlock ligne par ligne, pour que `onLockLocked` arrive à
#               temps), hyprctl, jq, qs (coque, cible IPC `verrou` : tomber, poserSec, remonter, abreger, etat ; rideau,
#               ~/.config/quickshell/dunei/Rideau/shell.qml), busctl, systemd-run, systemctl, pgrep (borné), id,
#               timeout, sed, cat, kill, date (GNU, millisecondes), notify-send, logger ; /proc (Linux).

RUN="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR absent}/dunei"
SEC="$RUN/verrou-sec" ORDRE="$RUN/verrou-ordre" JOURNAL="$RUN/verrou-hyprlock.log"
REPLI="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.conf"
JETONS="${XDG_CONFIG_HOME:-$HOME/.config}/dunei"
RIDEAU="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/dunei/Rideau/shell.qml"
MOTION="$JETONS/motion.json" VOILE="$RUN/verrou-rideau.log"
UNITE=dunei-verrou COQUE=dunei-coque.service
# Bornes, en ms : réponse d'un appel extérieur ; verrou pris par hyprlock ; compositeur muet avant de le croire tenu ;
# coque muette à la remontée ; sortie « rapide » de hyprlock ; pause avant de relancer après une sortie rapide (s) ;
# compositeur muet de suite pendant le suivi d'un verrou, avant d'y renoncer ; sortie de hyprlock après SIGTERM ;
# rideau posé (première image de chaque écran).
BORNE=0.2 BORNE_MS=200 ECHEANCE=2500 INCONNU_MAX=2000 MUETTE_REMONTEE=2000 RAPIDE=1000 PAUSE=0.5 SUIVI_MUET=5000
TERME=1000 RIDEAU_MAX=500
LANCEMENTS=3

# duree — délai d'animation en millisecondes, lu dans les jetons de mouvement.
# Entrées : $1, clé de `delays` dans motion.json ; $2, valeur par défaut (celle de motion.toml).
# Sortie : le délai sur la sortie standard. Erreurs : fichier absent ou illisible, clé manquante, valeur qui n'est pas
# un entier positif écrit en chiffres (1000.5, -1, texte) → valeur par défaut, car l'arithmétique du shell n'accepte
# que des entiers et une valeur fautive l'arrêterait avant tout verrou. Dépendances : jq.
duree() {
    v=$(jq -r --arg k "$1" '.delays[$k] // empty' "$MOTION" 2>/dev/null)
    case $v in '' | *[!0-9]*) v=$2 ;; esac
    echo "$v"
}

# maintenant — horloge en millisecondes. Sortie : l'heure Unix en ms. Dépendances : date (GNU, %3N).
maintenant() { date +%s%3N; }

# ipc — appel borné à la coque. Entrées : méthode de la cible `verrou` et ses arguments.
# Sortie : la réponse de la coque ; code non nul si elle est absente ou muette plus de 0,2 s. Dépendances : qs, timeout.
ipc() { timeout "$BORNE" qs ipc -c dunei call verrou "$@"; }

# verrou — état de la session d'après le compositeur, à trois issues.
# Sortie : « oui » (tenue), « non » (rendue) ou « inconnu » (hyprctl muet plus de 0,2 s, absent ou réponse illisible).
# Dépendances : hyprctl, jq, timeout.
verrou() {
    case $(timeout "$BORNE" hyprctl -j locked 2>/dev/null | jq -r .locked 2>/dev/null) in
        true) echo oui ;; false) echo non ;; *) echo inconnu ;;
    esac
}

# tenu — dit si la session est sûrement verrouillée. Sortie : code 0 sur « oui » seulement. Dépendances : verrou.
tenu() { [ "$(verrou)" = oui ]; }

# verrou_franc — état de la session, relu par pas de 20 ms tant que la réponse manque, au plus $INCONNU_MAX ms.
# Sortie : « oui », « non », ou « inconnu » si le compositeur est resté muet : un inconnu ne vaut ni verrou tenu ni
# session rendue. Dépendances : verrou, maintenant.
verrou_franc() {
    f=$(($(maintenant) + INCONNU_MAX))
    while :; do
        e=$(verrou)
        { [ "$e" = inconnu ] && [ "$(maintenant)" -lt "$f" ]; } || { echo "$e"; return; }
        sleep 0.02
    done
}

# vivant — dit si un processus vit encore, d'après son état dans /proc/<pid>/stat (un zombie est mort).
# Entrée : $1, PID. Sortie : code 0 s'il vit ; non nul s'il a disparu ou n'est plus qu'un zombie. Dépendances : sed.
vivant() {
    case $(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null) in '' | Z* | X*) return 1 ;; esac
}

# veille — dit si une mise en veille est annoncée.
# Sortie : code 0 si logind annonce `PreparingForSleep` ou ne rend pas « b false » en 0,2 s ; non nul au repos.
# Dépendances : busctl, timeout.
veille() {
    [ "$(timeout "$BORNE" busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager PreparingForSleep 2>/dev/null)" != "b false" ]
}

# sonder — état de la coque, d'après son `etat`, sous l'ordre courant.
# Entrées : aucune ; lit $ordre.
# Sortie : « tient » (verrou acquis sous l'ordre courant), « couvre » (bloc voulu sous l'ordre courant, verrou pas
#          encore acquis), « repond » (coque vivante sans bloc sous l'ordre courant : jamais avertie, relancée, ou
#          posée d'elle-même sous un autre ordre), « muette » (borne de 0,2 s dépassée, ou réponse illisible), ou
#          « absente » (qs en échec sans dépasser sa borne : aucune instance).
# Erreurs : aucune n'est remontée ; une coque muette ou illisible n'est jamais prise pour absente ni pour tenante.
# Dépendances : ipc, jq.
sonder() {
    r=$(ipc etat 2>/dev/null); c=$?
    case $c in 0) ;; 124) echo muette; return ;; *) echo absente; return ;; esac
    e=$(printf '%s' "$r" | jq -r --argjson o "$ordre" \
        'if .ordre != $o then "repond" elif .tient then "tient" elif .couvre then "couvre" else "repond" end' 2>/dev/null)
    echo "${e:-muette}"
}

# veille_demandee — dit si une veille a été annoncée en cours de route et, la première fois, abrège la chute.
# Sortie : code 0 si verrou-sec existe (la coque reçoit alors `abreger` une seule fois) ; non nul sinon.
# Dépendances : ipc ; $abrege.
veille_demandee() {
    [ -e "$SEC" ] || return 1
    [ "$abrege" = 1 ] || { ipc abreger >/dev/null 2>&1; abrege=1; }
}

# couleur — couleur `surface-base` du thème actif de la coque, pour le rideau.
# Rôle : suit le choix de Theme.qml en une expression courte : le couple {famille, moment} de theme.json s'il existe
#        dans les jetons, sinon le défaut des jetons. Le cas d'un thème retiré (Theme.qml prend alors la première
#        famille qui offre ce moment) tombe ici sur le défaut : le rideau ne se voit que 20 à 70 ms, l'écart ne vaut
#        pas une expression plus longue.
# Entrées : aucune ; lit $JETONS/coque-tokens.json et, facultatif, $JETONS/theme.json.
# Sortie : « #rrggbb » sur la sortie standard. Erreurs : jetons absents ou illisibles, theme.json illisible, valeur
#          qui n'est pas #rrggbb, jq muet plus de 0,2 s → « black ». Dépendances : jq, timeout, cat.
couleur() {
    c=$({ cat "$JETONS/coque-tokens.json"; cat "$JETONS/theme.json" 2>/dev/null; } 2>/dev/null | timeout "$BORNE" jq -rn \
        'input as $b | (try input catch null) as $c | $b.defaut as $d
         | ((try $b.themes[$c.famille][$c.moment] catch null) // $b.themes[$d.famille][$d.moment]).color.surfaceBase' \
        2>/dev/null)
    case $c in \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) echo "$c" ;; *) echo black ;; esac
}

# rideau_poser — pose le rideau et attend qu'il soit dessiné sur chaque écran.
# Entrées : aucune. Sortie : rideau (PID du rideau) ; retour dès « rideau : posé » dans $VOILE, si le rideau meurt, ou
#           au plus $RIDEAU_MAX ms après son lancement. Erreurs : aucune ; un rideau lent ou absent ne retarde jamais
#           hyprlock au-delà de la borne. Dépendances : qs, couleur, vivant, maintenant, cat.
rideau_poser() {
    DUNEI_RIDEAU_COULEUR=$(couleur) qs -p "$RIDEAU" >"$VOILE" 2>&1 & rideau=$!
    g=$(($(maintenant) + RIDEAU_MAX))
    while vivant "$rideau" && [ "$(maintenant)" -lt "$g" ]; do
        case $(cat "$VOILE" 2>/dev/null) in *"rideau : posé"*) return ;; esac
        sleep 0.02
    done
}

# rideau_retirer — retire le rideau, s'il est posé : SIGTERM, attente de sa fin par pas de 20 ms, au plus $TERME ms,
# puis SIGKILL s'il vit encore, et récolte du processus. Un rideau survivant couvrirait le bureau rendu et garderait
# l'unité du lanceur active. Entrées : aucune ; lit $rideau. Sortie : rideau vidé.
# Erreurs : un rideau déjà mort est ignoré ; un rideau sourd à SIGTERM est tué et l'écart est écrit au journal.
# Dépendances : kill, vivant, maintenant, logger.
rideau_retirer() {
    [ -n "$rideau" ] || return 0
    kill "$rideau" 2>/dev/null; g=$(($(maintenant) + TERME))
    while vivant "$rideau" && [ "$(maintenant)" -lt "$g" ]; do sleep 0.02; done
    ! vivant "$rideau" || { logger -t "$UNITE" "rideau sourd à SIGTERM en $TERME ms : tué"
        kill -KILL "$rideau" 2>/dev/null; }
    wait "$rideau" 2>/dev/null; rideau=
}

# verrouilleur — dit si un hyprlock de l'utilisateur vit peut-être encore (second lanceur hors unité).
# Sortie : code 0 si pgrep en trouve un, ou s'il ne répond pas en 0,2 s (un doute ne vaut jamais « aucun
#          verrouilleur », qui mènerait à lancer hyprlock par-dessus) ; non nul s'il répond qu'il n'y en a aucun.
# Erreurs : le doute est écrit au journal. Dépendances : pgrep, id, timeout, logger.
verrouilleur() {
    timeout "$BORNE" pgrep -u "$(id -u)" -x hyprlock >/dev/null; c=$?
    [ "$c" != 124 ] || { logger -t "$UNITE" "pgrep muet : verrouilleur présumé vivant"; return 0; }
    [ "$c" = 0 ]
}

# rideau_lever — retire le rideau dès que hyprlock tient le verrou (ligne `onLockLocked` de son journal), au plus
# $ECHEANCE ms après son lancement. Entrées : aucune ; lit $rideau, $lance. Sortie : aucune.
# Erreurs : aucune. Dépendances : rideau_retirer, maintenant, cat.
rideau_lever() {
    [ -n "$rideau" ] || return 0
    case $(cat "$JOURNAL" 2>/dev/null) in *onLockLocked*) rideau_retirer; return ;; esac
    [ "$(maintenant)" -lt $((lance + ECHEANCE)) ] || rideau_retirer
}

# secours — lance hyprlock sur la configuration statique, sa sortie ligne par ligne au journal du verrou ; derrière le
# rideau si la session est déjà tenue (verrou abandonné : sans rideau, la reprise laisserait voir la session).
# Entrées : aucune. Sortie : pid (PID de hyprlock : stdbuf l'exécute à sa place), lance (heure du lancement, ms),
#           tenant=hyprlock, pris=0 (verrou pas encore vu tenu sous ce lancement), tue=0, reprise vidée ; rideau posé
#           s'il y a lieu. Erreurs : aucune ; un hyprlock qui ne prend pas le verrou est traité par la garde.
# Le journal est vidé avant le lancement : rideau_lever n'y lit jamais le `onLockLocked` d'un hyprlock précédent.
# Dépendances : tenu, rideau_poser, stdbuf, hyprlock, maintenant.
secours() {
    [ -n "$rideau" ] || ! tenu || rideau_poser
    : >"$JOURNAL"
    stdbuf -oL hyprlock --no-fade-in -c "$REPLI" >"$JOURNAL" 2>&1 & pid=$!
    lance=$(maintenant) tenant=hyprlock pris=0 tue=0 reprise=
}

# relayer — un tour de relais pendant que hyprlock garde la session.
# Entrées : aucune ; lit $pid, $ordre et $apparue (1 si la coque présente a déjà reçu `poserSec`).
# Sortie : coque au verrou sous l'ordre courant → hyprlock terminé par SIGTERM, attendu, puis tenant=coque et vu=1 ;
#          rideau retiré, s'il restait ; coque qui répond sans bloc sous l'ordre courant → `poserSec`, une fois par
#          apparition de la coque ; coque absente → apparue=0, pour que son retour reçoive de nouveau `poserSec`.
#          Erreurs : jamais de SIGUSR1, qui rendrait toute la session ; un hyprlock encore vivant $TERME ms après le
#          SIGTERM est tué (SIGKILL, sans risque : la coque tient déjà le verrou) et l'écart est écrit au journal ; un
#          `poserSec` sans réponse est retenté au tour suivant. Dépendances : sonder, ipc, vivant, maintenant, logger.
relayer() {
    case $(sonder) in
        tient) logger -t "$UNITE" "coque au verrou : hyprlock terminé"
               kill -TERM "$pid" 2>/dev/null; g=$(($(maintenant) + TERME))
               while vivant "$pid" && [ "$(maintenant)" -lt "$g" ]; do sleep 0.02; done
               ! vivant "$pid" || { logger -t "$UNITE" "hyprlock sourd à SIGTERM en $TERME ms : tué"
                   kill -KILL "$pid" 2>/dev/null; }
               wait "$pid"; rideau_retirer; tenant=coque vu=1 reprise= ;;
        repond) [ "$apparue" = 1 ] || { ipc poserSec "$ordre" >/dev/null 2>&1 && apparue=1; } ;;
        absente) apparue=0 ;;
    esac
}

# suivre — attend la fin d'un verrou mené par un autre : le verrou vu tenu puis franchement rendu.
# Entrées : $1, 1 si l'appelant a déjà lu un « oui » franc (le premier « non » vaut alors déverrouillage), 0 sinon ;
#           $2, facultatif, échéance en ms (horloge de `maintenant`) de l'attente d'une unité encore active alors que
#           la session est franchement rendue : c'est l'unité d'un verrou qui finit (remontée du bloc, coque muette
#           jusqu'à $MUETTE_REMONTEE ms), et l'appel ne doit pas l'attendre au-delà de sa propre échéance de pose.
# Sortie : 0 au déverrouillage ; 1 si, pour l'appel extérieur seulement, l'unité du lanceur se termine sans que le
# verrou ait été vu tenu (le lanceur placé ne consulte jamais l'unité, qui est la sienne) ; 3 si l'échéance $2 passe
# sur un « non » franc, l'unité toujours active et le verrou jamais vu tenu ; 2 si le compositeur reste
# muet $SUIVI_MUET ms de suite (Hyprland mort ou figé) : le suivi y renonce, sans rien conclure sur la session, pour
# que l'unité ne survive pas au compositeur. Une réponse manquante isolée ne conclut rien. Pas de 20 ms jusqu'au
# verrou tenu, puis de 0,2 s, pour ne pas interroger le compositeur 50 fois par seconde pendant tout le verrou.
# Erreurs : le renoncement est écrit au journal. Dépendances : verrou, maintenant, systemctl, logger.
suivre() {
    vu=$1 muet=
    while :; do
        e=$(verrou)
        if [ "$e" != inconnu ]; then muet=
        elif [ -z "$muet" ]; then muet=$(($(maintenant) + SUIVI_MUET))
        elif [ "$(maintenant)" -ge "$muet" ]; then
            logger -t "$UNITE" "compositeur muet $SUIVI_MUET ms pendant le suivi : abandon"; return 2
        fi
        case $e in
            oui) vu=1 ;;
            non) [ "$vu" = 1 ] && return 0
                 [ -z "${DUNEI_VERROU_PORTEE:-}" ] || return 1
                 systemctl --user is-active --quiet "$UNITE.scope" || return 1
                 [ -z "${2:-}" ] || [ "$(maintenant)" -lt "$2" ] || return 3 ;;
        esac
        if [ "$vu" = 1 ]; then sleep "$BORNE"; else sleep 0.02; fi
    done
}

# remonter — fait remonter le bloc ; une coque muette 2 s est relancée (elle repart sans bloc, la session ouverte).
# Sortie : aucune. Dépendances : ipc, maintenant, systemctl, logger.
remonter() {
    f=$(($(maintenant) + MUETTE_REMONTEE))
    until ipc remonter "$ordre" >/dev/null 2>&1; do
        [ "$(maintenant)" -lt "$f" ] || { logger -t "$UNITE" "coque muette à la remontée : relance"
            systemctl --user restart "$COQUE"; return; }
        sleep 0.02
    done
}

[ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = --sec ]; } || { echo "usage : dunei-verrou [--sec]" >&2; exit 2; }
mkdir -p "$RUN"
# Heure de l'appel, prise par l'appel extérieur et transmise au lanceur placé (validée, plafonnée à maintenant) :
# l'échéance de la pose part d'elle, placement compris.
debut=$(maintenant)
if [ -n "${DUNEI_VERROU_PORTEE:-}" ]; then
    d="${DUNEI_VERROU_DEBUT:-}"; case $d in '' | *[!0-9]*) ;; *) [ "$d" -gt "$debut" ] || debut=$d ;; esac
fi

# Délai de l'échéance, lu avant le placement : debut + ATTENTE borne aussi le suivi d'une unité qui finit.
ATTENTE=$(duree verrouAttente 1500) REPRISE=$(duree verrouReprise 3000)

# Placement dans l'unité transitoire. Unité déjà là : un autre appel mène le verrou, on le suit ; s'il finit sans
# verrou tenu (appel arrivé pendant la fin d'un verrou), on retente le placement une fois, en verrou sec pour tenir la
# borne depuis l'appel réel (DUNEI_VERROU_SANS_CHUTE). Si l'unité reste active, la session franchement rendue, au-delà
# de l'échéance de la pose (remontée d'un verrou qui finit, coque muette), on ne l'attend plus : le verrou sec part
# hors unité, à côté d'elle, comme après un échec de systemd-run. systemd-run en échec pour une autre cause : le
# verrou passe avant l'unité, le lanceur continue hors d'elle.
if [ -z "${DUNEI_VERROU_PORTEE:-}" ]; then
    trace="$RUN/verrou-place-$$" relu=0 sans_chute=
    trap 'rm -f "$trace"' EXIT
    trap 'exit 1' HUP INT TERM
    while :; do
        if systemctl --user is-active --quiet "$UNITE.scope"; then
            ! veille || : >"$SEC"
            suivre 0 $((debut + ATTENTE)); c=$?
            [ "$c" != 0 ] || exit 0
            [ "$c" != 3 ] || { logger -t "$UNITE" "unité encore active, session rendue, à l'échéance : verrou hors unité"
                DUNEI_VERROU_DEBUT="$debut" DUNEI_VERROU_SANS_CHUTE=1 DUNEI_VERROU_PORTEE=- exec "$0" "$@"; }
            { [ "$c" = 1 ] && [ "$relu" = 0 ]; } || exit 1
            relu=1 sans_chute=1; continue
        fi
        rm -f "$SEC" "$trace"
        DUNEI_VERROU_DEBUT="$debut" DUNEI_VERROU_SANS_CHUTE="$sans_chute" DUNEI_VERROU_PORTEE="$trace" systemd-run --user --scope --unit="$UNITE" --collect --quiet "$0" "$@"; c=$?
        [ ! -e "$trace" ] || { rm -f "$trace"; exit "$c"; }
        systemctl --user is-active --quiet "$UNITE.scope" && continue
        break
    done
    logger -t "$UNITE" "systemd-run en échec ($c) : verrou hors unité"
    DUNEI_VERROU_DEBUT="$debut" DUNEI_VERROU_SANS_CHUTE="$sans_chute" DUNEI_VERROU_PORTEE=- exec "$0" "$@"
fi
[ "$DUNEI_VERROU_PORTEE" = - ] || : >"$DUNEI_VERROU_PORTEE"

n=$(cat "$ORDRE" 2>/dev/null); case $n in '' | *[!0-9]*) n=0 ;; esac
ordre=$((n + 1)); echo "$ordre" >"$ORDRE"
# tenant : qui garde la session (vide tant que personne, « coque » ou « hyprlock ») ; apparue : la coque présente a
# reçu son ordre ; issue : fin (session rendue) ou echec (verrou jamais tenu, compositeur muet) ; reprise : échéance
# (ms) laissée à la coque pour tenir de nouveau le verrou, vide tant qu'elle le tient ; rideau : PID du rideau posé.
tenant='' apparue=0 abrege=0 sec=0 vu=0 essais=0 inconnus=0 muet='' issue='' pid='' pris=0 tue=0 lance=0 reprise=''
rideau=''
[ -z "${DUNEI_VERROU_SANS_CHUTE:-}" ] || sec=1
trap 'rm -f "$SEC"; rideau_retirer' EXIT
trap 'exit 1' HUP INT TERM

# Session déjà tenue. La coque au verrou (sous quelque ordre que ce soit : relancée, elle le reprend d'elle-même)
# reçoit poserSec, qui lui donne l'ordre courant, et passe à la garde : si elle meurt ensuite, la reprise par hyprlock
# derrière le rideau reste assurée. Un hyprlock vivant (ou pgrep muet) la garde : on la suit jusqu'au déverrouillage,
# puis le bloc remonte. Sinon, la coque vivante sans verrou reçoit poserSec et passe à la garde, chrono de reprise
# lancé ; sans elle, hyprlock la reprend derrière le rideau.
if tenu; then
    tient=$(ipc etat 2>/dev/null | jq -r .tient 2>/dev/null)
    if [ "$tient" != true ] && verrouilleur; then suivre 1 || exit 1; remonter; exit 0; fi
    case $tient:$(sonder) in
        true:* | *:tient | *:couvre | *:repond)
            logger -t "$UNITE" "session tenue sans verrouilleur : garde par la coque"
            ! ipc poserSec "$ordre" >/dev/null 2>&1 || apparue=1
            tenant=coque reprise=$(($(maintenant) + REPRISE)) ;;
        *) logger -t "$UNITE" "session tenue sans verrouilleur ni coque : hyprlock"; secours ;;
    esac
fi

# 1. Entrée. À l'ouverture de session, hyprlock d'abord, puis la coque si elle est déjà là. Sinon, la coque pose son
# bloc sans mouvement (verrou sec) ou le fait tomber ; absente ou muette, hyprlock part aussitôt.
if [ -n "$tenant" ]; then :
elif [ "${1:-}" = --sec ]; then
    secours; ! ipc poserSec "$ordre" >/dev/null 2>&1 || apparue=1
else
    if [ "$sec" = 1 ] || veille; then ipc poserSec "$ordre" >/dev/null 2>&1; else ipc tomber "$ordre" >/dev/null 2>&1; fi
    if [ $? = 0 ]; then apparue=1
    else logger -t "$UNITE" "coque absente ou muette à l'entrée : hyprlock"; secours
    fi
fi

# 2. Échéance. Attente, par pas de 20 ms, de la session tenue par la coque sous l'ordre courant. Aucun `etat` n'est
# lancé à moins de 0,4 s de l'échéance (`etat` puis `tenu`, bornés chacun à 0,2 s), pour que hyprlock parte à son heure. Une coque disparue ne porte plus de bloc :
# hyprlock part aussitôt. À l'échéance, une session tenue reste à la coque (hyprlock lui volerait le verrou) ; sinon,
# hyprlock part.
f=$((debut + ATTENTE))
while [ -z "$tenant" ]; do
    veille_demandee
    if [ $(($(maintenant) + 2 * BORNE_MS)) -lt "$f" ]; then
        e=$(sonder)
        [ "$e" != absente ] || { logger -t "$UNITE" "coque disparue pendant la chute : hyprlock"; apparue=0; secours
            break; }
        [ "$e" = tient ] && tenu && { tenant=coque vu=1; break; }
    elif [ "$(maintenant)" -ge "$f" ]; then
        if tenu; then tenant=coque vu=1
        else logger -t "$UNITE" "session non tenue à l'échéance ($ATTENTE ms) : hyprlock"; secours
        fi
        break
    fi
    sleep 0.02
done

# 3. Garde, tant que la session n'est pas rendue. Sous la coque : lecture du compositeur et de la coque toutes les
# 0,2 s ; une coque qui ne répond plus `tient` déclenche le chrono de reprise ($REPRISE ms), remis à zéro par un
# `tient` seulement ; relancée sans notre ordre, elle reçoit poserSec. Passé le chrono, hyprlock reprend le verrou
# derrière le rideau. Sous hyprlock : rideau retiré à `onLockLocked`, verrou pris en $ECHEANCE ms ou hyprlock tué,
# relais vers la coque à chaque tour ; à la sortie de hyprlock, la session tenue revient à la coque si elle répond,
# sinon hyprlock est relancé tant que la session reste tenue (ou que la réponse manque).
while :; do
    case $tenant in
    coque)
        case $(verrou) in
            non) issue=fin; break ;;
            oui) muet= ;;
            *) [ -n "$muet" ] || muet=$(($(maintenant) + SUIVI_MUET))
               [ "$(maintenant)" -lt "$muet" ] || {
                   logger -t "$UNITE" "compositeur muet $SUIVI_MUET ms sous le verrou de la coque : abandon"; exit 1; } ;;
        esac
        e=$(sonder)
        if [ "$e" = tient ]; then reprise=; else [ -n "$reprise" ] || reprise=$(($(maintenant) + REPRISE)); fi
        case $e in
            repond) [ "$apparue" = 1 ] || { ipc poserSec "$ordre" >/dev/null 2>&1 && apparue=1; } ;;
            absente) apparue=0 ;;
        esac
        if [ -n "$reprise" ] && [ "$(maintenant)" -ge "$reprise" ] && tenu; then
            logger -t "$UNITE" "coque sans verrou depuis $REPRISE ms : hyprlock derrière le rideau"; secours; continue
        fi
        sleep "$BORNE" ;;
    hyprlock)
        if vivant "$pid"; then
            if [ "$pris" = 0 ]; then
                if tenu; then pris=1 vu=1
                elif [ "$(maintenant)" -ge $((lance + ECHEANCE)) ]; then
                    logger -t "$UNITE" "verrou non pris en $ECHEANCE ms : hyprlock tué"; kill -KILL "$pid" 2>/dev/null; tue=1
                fi
            fi
            rideau_lever; relayer
            if [ "$pris" = 1 ] && [ -z "$rideau" ]; then sleep "$BORNE"; else sleep 0.02; fi
            continue
        fi
        wait "$pid"; rideau_retirer
        e=$(verrou_franc)
        if [ "$e" = non ]; then
            inconnus=0
            [ "$vu" = 1 ] && { issue=fin; break; }
            essais=$((essais + 1))
            logger -t "$UNITE" "verrou jamais tenu, lancement $essais sur $LANCEMENTS"
            [ "$essais" -lt "$LANCEMENTS" ] || { issue=echec; break; }
            secours; continue
        fi
        # Session encore tenue, ou compositeur muet. Seul un « oui » franc vaut verrou vu ; un inconnu ne compte ni
        # comme tenu ni comme lancement manqué, et trois de suite mènent à l'échec du verrou, jamais à 0. Une coque qui
        # répond reçoit poserSec et reprend la garde, chrono de reprise lancé : relancer hyprlock lui volerait le
        # verrou. Un autre hyprlock vivant (second lanceur hors unité) la garde aussi : on le suit, puis on remonte le
        # bloc sous notre ordre. Sinon hyprlock est relancé, après une pause s'il est sorti vite.
        if [ "$e" = oui ]; then vu=1 inconnus=0
        else inconnus=$((inconnus + 1)); logger -t "$UNITE" "compositeur muet, $inconnus fois de suite"
            [ "$inconnus" -lt "$LANCEMENTS" ] || { issue=echec; break; }
        fi
        if [ "$e" = oui ]; then
            case $(sonder) in tient | couvre | repond)
                logger -t "$UNITE" "hyprlock sorti, session tenue : rendue à la coque"
                ! ipc poserSec "$ordre" >/dev/null 2>&1 || apparue=1
                tenant=coque reprise=$(($(maintenant) + REPRISE)); continue ;;
            esac
        fi
        if [ "$e" = oui ] && verrouilleur; then suivre 1 || exit 1; issue=fin; break; fi
        [ "$tue" = 1 ] || [ $(($(maintenant) - lance)) -ge "$RAPIDE" ] || sleep "$PAUSE"
        logger -t "$UNITE" "hyprlock sorti, session $e : relance"; secours ;;
    esac
done

# 4. Fin : la session rendue, le bloc remonte (sans effet si la coque remonte déjà). Échec du verrou : à l'ouverture de
# session, dunei-verrou-initial ferme la session ; sinon elle reste ouverte.
[ "$issue" = fin ] && { remonter; exit 0; }
[ "${1:-}" = --sec ] && exit 1
timeout 2 notify-send -u critical "Verrouillage impossible" "hyprlock n'a pas tenu le verrou ; la session reste ouverte."
remonter
exit 1
